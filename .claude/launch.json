{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "watchtower-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "src/watchtower-web"],
      "port": 5173
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "src/watchtower-web", "--", "--port", "5201", "--strictPort"],
      "port": 5201
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Watchtower.Api",
        "--no-build",
        "--",
        "--Watchtower:Database:ConnectionString=Host=127.0.0.1;Port=5432;Database=watchtower;Username=postgres;Password=postgres"
      ],
      "port": 5080
    }
  ]
}
