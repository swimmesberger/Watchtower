<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Elarion application framework — consumed from NuGet (github.com/swimmesberger/Elarion). -->
    <ElarionVersion>0.2.6</ElarionVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Elarion framework (public NuGet packages) -->
    <PackageVersion Include="Elarion" Version="$(ElarionVersion)" />
    <PackageVersion Include="Elarion.Abstractions" Version="$(ElarionVersion)" />
    <PackageVersion Include="Elarion.AspNetCore" Version="$(ElarionVersion)" />
    <PackageVersion Include="Elarion.JsonRpc" Version="$(ElarionVersion)" />
    <PackageVersion Include="Elarion.AspNetCore.Mcp" Version="$(ElarionVersion)" />
    <PackageVersion Include="Elarion.EntityFrameworkCore" Version="$(ElarionVersion)" />
    <PackageVersion Include="Elarion.Settings" Version="$(ElarionVersion)" />
    <PackageVersion Include="Elarion.Settings.EntityFrameworkCore" Version="$(ElarionVersion)" />
    <PackageVersion Include="Elarion.Settings.Configuration" Version="$(ElarionVersion)" />
    <!-- The cross-instance primitives the proxy/auth plane needs once its state lives in the database
         (ADR-0024 decisions 5 and 6). All three are PostgreSQL-backed by construction:
         Coordination.PostgreSql is the `acme-issuer` role lease, Settings.PostgreSql is the
         LISTEN/NOTIFY change channel that carries Watchtower:Proxy:RoutesVersion, and
         Scheduling.EntityFrameworkCore claims a [ScheduledJob] occurrence so it runs once
         cluster-wide rather than once per instance. -->
    <PackageVersion Include="Elarion.Coordination.PostgreSql" Version="$(ElarionVersion)" />
    <PackageVersion Include="Elarion.Settings.PostgreSql" Version="$(ElarionVersion)" />
    <PackageVersion Include="Elarion.Scheduling.EntityFrameworkCore" Version="$(ElarionVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core — PostgreSQL/Npgsql provider, the only database backend (ADR-0024). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!-- Pinned alongside the others rather than left to the transitive graph: the design-time tooling
         asks for it directly and the Npgsql provider only asks for a floor, so without this the API
         project and the test project that hosts it resolve different versions of the same assembly —
         which surfaces at run time as a missing-assembly load failure, not as a build warning. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- The ASP.NET data-protection key ring as rows in the same context (ADR-0024 decision 4), so a
         cookie or a password-reset token minted on one instance is readable on every other. Elarion has
         no key-ring helper; the ASP.NET one composes with the existing DbContext. -->
    <!-- 10.0.11 rather than 10.0.9: Microsoft.AspNetCore.DataProtection drags in
         System.Security.Cryptography.Xml, and every version of it up to 10.0.9 carries the XML-signature
         advisories (GHSA-23rf-6693-g89p and four siblings). That floor is also why the EF Core versions
         above are 10.0.11 — this package requires the matching one. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.11" />
    <!-- SQLite, kept for exactly one thing: the one-shot `import-sqlite` command that carries a
         pre-ADR-0024 installation into PostgreSQL (Services/SqliteImport). No EF SQLite provider —
         the importer reads the old file with the raw ADO.NET client and writes through COPY. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Transitive pin: fix GHSA-2m69-gcr7-jv3q (SQLite vuln in the e_sqlite3 native bundled with
         Microsoft.Data.Sqlite). The native lib package is versioned independently of the managed
         SQLitePCLRaw layer and is designed to be bumped on its own. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

  <!-- ASP.NET Identity *core* (UserManager, password hasher, lockout/security-stamp) is NOT pinned
       here: Microsoft.Extensions.Identity.Core ships inside the Microsoft.AspNetCore.App shared
       framework the projects already reference, so an explicit PackageReference is rejected as
       redundant (NU1510). It is therefore versioned by the targeted framework, like the rest of
       Microsoft.Extensions.* — see docs/central-auth/design.md §2.4. -->

  <ItemGroup>
    <!-- SFTP uploads for the stack backup storage provider (ADR-0016). Pure managed, no native
         payload — the shipped image grows no new binaries. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- libsodium sealed boxes for pushing GitHub Actions secrets (docs/ci-runners/design.md, Secrets §1). -->
    <PackageVersion Include="Sodium.Core" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- ES256 identity assertions forwarded to protected apps (docs/central-auth/design.md §2.3): token
         minting, the JWKS document, and the validation the tests do against it. Not part of the ASP.NET
         shared framework (only the JwtBearer *handler* would be, and we are the issuer, not a consumer). -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-process reverse proxy (ADR-0022, forthcoming). Only the direct-forwarding half is used —
         IHttpForwarder plus HttpTransformer — not YARP's own config/routing pipeline, because Watchtower
         already owns the route table and dispatches by Host itself. Referenced by Watchtower.Api alone:
         the Application layer stays proxy-agnostic, so the projection and the access decision remain
         testable without a web stack. Pure managed, and the net8 asset runs on net10. -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test stack (xunit v3). -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- WebApplicationFactory, for exercising the real Program.cs pipeline (auth middleware order,
         endpoint gating, cookie attributes) rather than a hand-rebuilt approximation of it. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <!-- The integration suites run against a real PostgreSQL (ADR-0024). Testcontainers starts one per
         test run from Docker/Podman; WATCHTOWER_TEST_PG points them at an already-running server
         instead (CI's service container, or a locally started `podman run postgres`). -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET Aspire — dev-time orchestration only (the AppHost runs the API + Vite web together).
         Not part of the shipped Docker image. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.4.6" />
    <!-- The development database: a Postgres container with a data volume (ADR-0024). -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <!-- Direct pin for the Aspire/DCP transitive dependency vulnerable below MessagePack 2.5.301. -->
    <PackageVersion Include="MessagePack" Version="3.1.7" />
  </ItemGroup>
</Project>
