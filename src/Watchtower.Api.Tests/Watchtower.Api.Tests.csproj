<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- xunit.v3 test projects are self-executing test hosts. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The PostgreSQL every test runs against (ADR-0024), unless WATCHTOWER_TEST_PG names one. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Watchtower.Api\Watchtower.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked rather than duplicated: the TOTP generator stands in for an authenticator app in both test
         projects, and a second copy of RFC 6238 arithmetic is a second thing to get subtly wrong. A project
         reference is not the alternative — one test assembly referencing another drags its whole test
         collection into this runner. -->
    <Compile Include="..\Watchtower.Application.Tests\TotpCodes.cs" Link="TotpCodes.cs" />
    <!-- Linked for the same reason: both assemblies need a real PostgreSQL, and two implementations of
         "start a server, migrate a template, hand out databases" would drift. Each test assembly is its
         own process, so each gets its own server unless WATCHTOWER_TEST_PG points both at one. -->
    <Compile Include="..\Watchtower.Application.Tests\PostgresTestServer.cs" Link="PostgresTestServer.cs" />
  </ItemGroup>

</Project>
