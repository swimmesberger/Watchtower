<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Watchtower.Api" />
    <!-- Internal seams the unit tests exercise directly without Docker or a database — e.g.
         CaddyManager.DecideTransition. (The route-table-to-site-list projection moved to the public
         ProxySiteProjection and no longer needs this.) -->
    <InternalsVisibleTo Include="Watchtower.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Elarion framework (NuGet). The Elarion package bundles the module/handler generator;
         Elarion.EntityFrameworkCore bundles the DbContext/[EntityConfiguration] generator. -->
    <PackageReference Include="Elarion" />
    <PackageReference Include="Elarion.EntityFrameworkCore" />
    <PackageReference Include="Elarion.Settings" />
    <PackageReference Include="Elarion.Settings.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core with the Npgsql provider — PostgreSQL is the only backend (ADR-0024). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- SQLite, for the one-shot `import-sqlite` command only (Services/SqliteImport): it reads a
         pre-ADR-0024 database file and COPYs it into PostgreSQL. No EF SQLite provider is referenced. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Referenced directly so the pinned e_sqlite3 native version (GHSA-2m69-gcr7-jv3q) actually applies. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <!-- JWT minting + JWKS for the identity assertion forwarded to protected apps (AuthTokenSigner). -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <!-- SFTP backup storage provider (ADR-0016). -->
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings the shared framework (Microsoft.Extensions.* hosting/logging/options/DI) used by the
         background services and the ASP.NET-hosted handler pipeline. It also supplies ASP.NET
         Identity *core* (Microsoft.Extensions.Identity.Core) behind WatchtowerUserStore — that
         assembly is part of the shared framework, so it needs no PackageReference (NU1510). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
